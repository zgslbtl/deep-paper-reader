    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "not_reported",
              "partially_reported",
              "ambiguous"
            ]
          },
          "trigger": {
            "$ref": "#/$defs/claim"
          },
          "missing_information": {
            "$ref": "#/$defs/claim"

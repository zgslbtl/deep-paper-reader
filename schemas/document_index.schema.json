{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-paper-reader.local/schemas/document_index.schema.json",
  "title": "document_index",
  "type": "object",
  "properties": {
    "paper_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "doi": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "source": {
          "const": "pdf_metadata_unverified"
        }
      },
      "required": [
        "title",
        "authors",
        "year",
        "doi",
        "venue",
        "source"
      ],
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "rotation": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "image_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "page",
          "width",
          "height",
          "rotation",
          "text",
          "image_path"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "block_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "detection": {
            "const": "heuristic"
          }
        },
        "required": [
          "section_id",
          "title",
          "page",
          "block_id",
          "detection"
        ],
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": [
          "block_id",
          "page",
          "text",
          "bbox"
        ],
        "additionalProperties": false
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "number": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "block_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "nearby_block_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          },
          "image_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "extraction_status": {
            "enum": [
              "page_reference",
              "extracted"
            ]
          },
          "warning": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "number",
          "page",
          "caption",
          "block_id",
          "bbox",
          "nearby_block_ids",
          "image_path",
          "extraction_status",
          "warning"
        ],
        "additionalProperties": false
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "number": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "block_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "nearby_block_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          },
          "image_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "extraction_status": {
            "enum": [
              "page_reference",
              "extracted"
            ]
          },
          "warning": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "number",
          "page",
          "caption",
          "block_id",
          "bbox",
          "nearby_block_ids",
          "image_path",
          "extraction_status",
          "warning"
        ],
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "block_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "detection": {
            "const": "heuristic"
          }
        },
        "required": [
          "page",
          "block_id",
          "text",
          "detection"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "paper_id",
    "source_sha256",
    "metadata",
    "pages",
    "sections",
    "blocks",
    "figures",
    "tables",
    "references",
    "warnings"
  ],
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "summary_zh": {
          "type": "string",
          "minLength": 1
        },
        "summary_en": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "explicit",
            "supported_synthesis",
            "not_reported"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "summary_zh",
        "summary_en",
        "status",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_reported"
              }
            }
          },
          "then": {
            "properties": {
              "summary_zh": {
                "const": "文章未报告。"
              },
              "summary_en": {
                "const": "Not reported in the paper."
              },
              "evidence": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "supported_synthesis"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string"
        },
        "block_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "page",
        "section",
        "block_id",
        "quote",
        "bbox"
      ],
      "additionalProperties": false
    }
  }
}

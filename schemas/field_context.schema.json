{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-paper-reader.local/schemas/field_context.schema.json",
  "title": "field_context",
  "type": "object",
  "properties": {
    "generation_status": {
      "enum": [
        "not_generated",
        "generated"
      ]
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provenance": {
            "const": "external_knowledge"
          },
          "text_zh": {
            "type": "string",
            "minLength": 1
          },
          "text_en": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "accessed_at": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "title",
                "url",
                "accessed_at"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "provenance",
          "text_zh",
          "text_en",
          "references"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "generation_status",
    "context"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "generation_status": {
            "const": "not_generated"
          }
        }
      },
      "then": {
        "properties": {
          "context": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "summary_zh": {
          "type": "string",
          "minLength": 1
        },
        "summary_en": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "explicit",
            "supported_synthesis",
            "not_reported"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "summary_zh",
        "summary_en",
        "status",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_reported"
              }
            }
          },
          "then": {
            "properties": {
              "summary_zh": {
                "const": "文章未报告。"
              },
              "summary_en": {
                "const": "Not reported in the paper."
              },
              "evidence": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "supported_synthesis"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string"
        },
        "block_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "page",
        "section",
        "block_id",
        "quote",
        "bbox"
      ],
      "additionalProperties": false
    }
  }
}

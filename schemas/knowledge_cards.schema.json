                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                }
              },
              "required": [
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "related_cards": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          },
          "proposed_in_this_paper": {
            "type": "boolean"
          },
          "how_defined": {
            "$ref": "#/$defs/claim"
          },
          "how_derived": {
            "$ref": "#/$defs/claim"
          },
          "derivation_status": {
            "enum": [
              "explicit",
              "supported_synthesis",
              "not_reported"
            ]
          }
        },
        "required": [
          "card_id",
          "term",
          "type",
          "paper_usage",
          "definition",
          "plain_explanation",
          "input",
          "process",
          "output",
          "formula",
          "assumptions",
          "theoretical_basis",
          "origin",
          "references",
          "related_cards",
          "proposed_in_this_paper",
          "how_defined",
          "how_derived",
          "derivation_status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "generation_status",
    "cards"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "generation_status": {
            "const": "not_generated"
          }
        }
      },
      "then": {
        "properties": {
          "cards": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "summary_zh": {
          "type": "string",
          "minLength": 1
        },
        "summary_en": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "explicit",
            "supported_synthesis",
            "not_reported"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "summary_zh",
        "summary_en",
        "status",
        "evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_reported"
              }
            }
          },
          "then": {
            "properties": {
              "summary_zh": {
                "const": "文章未报告。"
              },
              "summary_en": {
                "const": "Not reported in the paper."
              },
              "evidence": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "supported_synthesis"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string"
        },
        "block_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "page",
        "section",
        "block_id",
        "quote",
        "bbox"
      ],
      "additionalProperties": false
    }
  }
}

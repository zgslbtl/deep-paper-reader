                "type": "string",
                "minLength": 1
              },
              "text_en": {
                "type": "string",
                "minLength": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "accessed_at": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "title",
                    "url",
                    "accessed_at"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "provenance",
              "text_zh",
              "text_en",
              "references"
            ],
            "additionalProperties": false
          },
          "formula": {
            "type": "object",
            "properties": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-paper-reader.local/schemas/knowledge_cards.schema.json",
  "title": "knowledge_cards",
  "type": "object",
  "properties": {
    "generation_status": {
      "enum": [
        "not_generated",
        "generated"
      ]
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "term": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "statistical_method",
              "computational_method",
              "theory_or_concept",
              "author_defined_method"
            ]
          },
          "paper_usage": {
            "$ref": "#/$defs/claim"
          },
          "definition": {
            "type": "object",
            "properties": {
              "provenance": {
                "const": "external_knowledge"
              },
              "text_zh": {
                "type": "string",
                "minLength": 1
              },
              "text_en": {
                "type": "string",
                "minLength": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    "accessed_at": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "title",
                    "url",
                    "accessed_at"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "provenance",
              "text_zh",
              "text_en",
              "references"
            ],
            "additionalProperties": false
          },
          "plain_explanation": {
            "type": "object",
            "properties": {
              "provenance": {
                "const": "external_knowledge"
              },
              "text_zh": {
                "type": "string",
                "minLength": 1
              },
              "text_en": {
                "type": "string",
                "minLength": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {

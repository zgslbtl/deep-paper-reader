                    },
                    "accessed_at": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "title",
                    "url",
                    "accessed_at"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "provenance",
              "text_zh",
              "text_en",
              "references"
            ],
            "additionalProperties": false
          },
          "origin": {
            "type": "object",
            "properties": {
              "provenance": {
                "const": "external_knowledge"
              },
              "text_zh": {
                "type": "string",
                "minLength": 1
              },
              "text_en": {
                "type": "string",
                "minLength": 1
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
